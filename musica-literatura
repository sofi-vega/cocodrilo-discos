/* ── Barra de título + Volver ── */
.barra-titulo{
  position:fixed; top:0; left:0; right:0; height:26px;
  background:linear-gradient(180deg, var(--verde-claro) 0%, var(--verde) 60%, var(--verde-oscuro) 100%);
  border-bottom:2px solid var(--oro); color:var(--crema);
  font-family:'Press Start 2P',monospace; font-size:8px; letter-spacing:1px;
  display:flex; align-items:center; padding-left:14px;
  z-index:100; text-shadow:1px 1px 0 var(--verde-oscuro);
}
.volver{
  position:fixed; top:38px; left:24px; z-index:80;
  padding:9px 15px; background:rgba(18,61,32,.92); color:var(--crema);
  border:2px solid var(--oro); text-decoration:none;
  font-family:'Press Start 2P',monospace; font-size:8px; letter-spacing:1px;
  box-shadow:3px 3px 0 rgba(0,0,0,.7); transition:transform .12s, background .12s;
}
.volver:hover{ transform:translate(-2px,-2px); background:var(--verde-claro); }

/* ====== REVISTA ====== */
.revista{
  max-width:960px; margin:18px auto;
  background:linear-gradient(180deg, var(--papel), var(--papel-2));
  border:1px solid #b9a87e;
  box-shadow:0 26px 60px rgba(0,0,0,.6);
  overflow:hidden;
}

/* ── PORTADA / HERO ── */
.hero{
  position:relative; overflow:hidden;
  background:linear-gradient(160deg, #16451f 0%, var(--verde) 45%, var(--verde-oscuro) 100%);
  color:var(--crema);
  padding:34px 52px 40px;
  border-bottom:4px solid var(--oro);
}
.hero::after{ /* scanlines retro */
  content:''; position:absolute; inset:0; pointer-events:none;
  background:repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,.10) 3px, rgba(0,0,0,.10) 5px);
}
.hero-top{
  display:flex; justify-content:space-between; align-items:center;
  font-family:'Oswald',sans-serif; font-weight:600; font-size:12px;
  letter-spacing:3px; text-transform:uppercase; color:var(--oro);
  border-bottom:1px solid rgba(224,180,60,.4); padding-bottom:12px;
}
.hero-kicker{
  font-family:'Oswald',sans-serif; font-weight:500; font-size:13px;
  letter-spacing:5px; text-transform:uppercase; color:var(--oro-bright);
