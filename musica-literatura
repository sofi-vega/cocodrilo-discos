}
em{ font-style:italic; }

/* ── FRASE DESTACADA (rompe a lo ancho) ── */
.destacada{
  column-span:all; margin:14px 0 26px;
  background:linear-gradient(160deg, var(--verde), var(--verde-oscuro));
  border-top:4px solid var(--oro); border-bottom:4px solid var(--oro);
  padding:30px 50px; text-align:center; position:relative;
