.hero-credito{ display:flex; align-items:center; gap:14px; margin-top:24px; }
.hero-credito .avatar{
  width:52px; height:52px; flex-shrink:0; border-radius:50%;
  background:linear-gradient(135deg, var(--oro-bright), #a87c1a);
  border:2px solid var(--crema);
  display:flex; align-items:center; justify-content:center;
  font-family:'Press Start 2P',monospace; font-size:12px; color:var(--verde-oscuro);
}
.hero-credito .quien{ font-family:'Oswald',sans-serif; font-weight:600; font-size:18px; letter-spacing:1px; color:var(--crema); }
.hero-credito .sub{ font-family:'Oswald',sans-serif; font-weight:400; font-size:12px; letter-spacing:2px; text-transform:uppercase; color:var(--oro); }

/* disco decorativo */
.disco-deco{
  position:absolute; top:-70px; right:-70px; width:230px; height:230px; border-radius:50%;
